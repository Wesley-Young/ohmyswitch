{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noEmptyInterface": "off",
        "noImportCycles": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":PACKAGE:"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"],
              ":BLANK_LINE:",
              [":BUN:", ":NODE:"]
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["biome.json"],
      "formatter": {
        "lineWidth": 80
      }
    },
    {
      "includes": ["**/tsconfig*.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "core 不依赖 Electron；Electron 能力由 src/main/plugins 中的插件以服务提供。",
                  "cordis": "只有模块的 index.ts、service.ts 依赖 cordis；其余文件是纯逻辑。"
                },
                "patterns": [
                  {
                    "group": [
                      "**/main/**",
                      "**/renderer/**",
                      "react",
                      "react-dom"
                    ],
                    "message": "core 不依赖主进程或界面。"
                  },
                  {
                    "group": ["@trpc/server", "@trpc/server/*"],
                    "message": "core 不依赖 tRPC；路由在 src/main/trpc/routes 中。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/*/index.ts", "src/core/*/service.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "core 不依赖 Electron；Electron 能力由 src/main/plugins 中的插件以服务提供。"
                },
                "patterns": [
                  {
                    "group": [
                      "**/main/**",
                      "**/renderer/**",
                      "react",
                      "react-dom"
                    ],
                    "message": "core 不依赖主进程或界面。"
                  },
                  {
                    "group": ["@trpc/server", "@trpc/server/*"],
                    "message": "core 不依赖 tRPC；路由在 src/main/trpc/routes 中。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/renderer/**"],
                    "message": "主进程不依赖界面代码。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "渲染进程不使用 Electron API，通过 tRPC 调用主进程。"
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "渲染进程运行在沙箱中，不使用 Node 模块。"
                  },
                  {
                    "group": ["**/main/**", "**/core/**"],
                    "message": "只有 lib/trpc.ts 引用主进程的类型；其他界面代码从 @/lib/trpc 导入。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "渲染进程不使用 Electron API，通过 tRPC 调用主进程。"
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "渲染进程运行在沙箱中，不使用 Node 模块。"
                  },
                  {
                    "group": ["**/main/**", "**/core/**"],
                    "message": "只有 lib/trpc.ts 引用主进程的类型；其他界面代码从 @/lib/trpc 导入。"
                  },
                  {
                    "group": ["@/components/**", "@/routes/**"],
                    "message": "lib/ 只放数据与工具函数，不依赖界面。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "渲染进程不使用 Electron API，通过 tRPC 调用主进程。"
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "渲染进程运行在沙箱中，不使用 Node 模块。"
                  },
                  {
                    "group": ["**/main/**", "**/core/**"],
                    "message": "只有 lib/trpc.ts 引用主进程的类型；其他界面代码从 @/lib/trpc 导入。"
                  },
                  {
                    "group": ["@/routes/**"],
                    "message": "页面只由 main.tsx 装配；共享的界面放在 components/。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "渲染进程不使用 Electron API，通过 tRPC 调用主进程。"
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "渲染进程运行在沙箱中，不使用 Node 模块。"
                  },
                  {
                    "group": ["**/main/**", "**/core/**"],
                    "message": "只有 lib/trpc.ts 引用主进程的类型；其他界面代码从 @/lib/trpc 导入。"
                  },
                  {
                    "group": ["@/routes/**", "./*"],
                    "message": "页面之间不互相导入；共享的界面放在 components/。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/lib/trpc.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/renderer/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off"
          }
        }
      }
    }
  ]
}
