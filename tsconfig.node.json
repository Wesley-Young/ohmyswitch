{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    // cordis publishes declarations with extensionless relative imports, which NodeNext cannot resolve. The main
    // process is bundled by electron-vite, so bundler resolution matches how it runs.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["node", "electron-vite/node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/core", "src/main", "electron.vite.config.ts"]
}
