{
  "name": "ohmyswitch",
  "productName": "ohmyswitch",
  "private": true,
  "version": "0.2.2",
  "description": "Provider-first config manager for AI coding harnesses",
  "author": "Wei FeiYang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wesley-Young/ohmyswitch.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "imports": {
    "#core/*": "./src/core/*",
    "#main/*": "./src/main/*",
    "#cli/*": "./src/cli/*",
    "#build/*": "./build/*"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsdown",
    "build:cli": "tsdown",
    "publish:cli": "node scripts/publish-cli.mjs",
    "oms": "node src/cli/index.ts",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ui:add": "node scripts/shadcn-add.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.5.15",
    "@clack/prompts": "^1.8.1",
    "@cordisjs/plugin-include": "1.1.1",
    "@cordisjs/plugin-loader": "1.0.0-rc.8",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lobehub/icons": "5.23.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cordis": "4.0.0-rc.11",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-log": "5.4.4",
    "electron-vite": "^6.0.0",
    "js-yaml": "^4.3.2",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
